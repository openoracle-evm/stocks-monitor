{
  "name": "@openoracle/stocks-monitor",
  "version": "0.1.0",
  "private": true,
  "description": "Open Oracle — tokenized-stock monitor: Pyth reference prices vs. on-chain pool prices, premium/discount, market hours. HTTP + SSE API.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@openoracle/sdk": "github:openoracle-evm/oracle-sdk",
    "fastify": "^5.12.5",
    "viem": "^2.57.4",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
